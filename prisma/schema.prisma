// BarterX: target production schema (PostgreSQL on Neon + pgvector).
// The running preview uses MongoDB with the same entities. This schema is checked
// with `prisma validate`, and its migrations are applied with `prisma migrate deploy`
// against a local Postgres 15 + pgvector 0.8.0 (Neon ships 0.8.0 for PG 14-17).
// Never use `prisma db push` against a shared or production database.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum ListingType {
  GOODS
  SERVICES
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  TRADED
  ARCHIVED
}

enum WantStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum TargetType {
  GOODS
  SERVICES
  ANY
}

enum ExchangeStatus {
  DRAFT
  PROPOSED
  APPROVED
  AWAITING_PAYMENTS
  PAYMENTS_COMPLETE
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum FulfilmentStatus {
  PENDING
  CONFIRMED
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  UNCLAIMED
  FAILED
  BLOCKED
}

enum OfferStatus {
  OPEN
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  MATCH
  CYCLE
  EXCHANGE
  APPROVAL
  PAYMENT
  PAYOUT
  FULFILMENT
  REVIEW
  SYSTEM
}

enum EmbeddingSubject {
  LISTING
  WANT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  bio          String   @default("")
  location     String   @default("")
  skills       String[]
  paypalEmail  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings        Listing[]
  wants           Want[]
  matches         Match[]
  participants    ExchangeParticipant[]
  payments        Payment[]
  payouts         Payout[]
  notifications   Notification[]
  offersSent      Offer[]               @relation("OfferFrom")
  offersReceived  Offer[]               @relation("OfferTo")
  reviewsWritten  Review[]              @relation("ReviewAuthor")
  reviewsReceived Review[]              @relation("ReviewSubject")
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @db.Uuid
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  description    String        @default("")
  type           ListingType
  category       String
  condition      String        @default("")
  estimatedValue Decimal       @db.Decimal(12, 2)
  currency       String        @db.Char(3)
  tags           String[]
  location       String        @default("")
  status         ListingStatus @default(ACTIVE)
  aiAssisted     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  offeredInWants Want[]
  matches        Match[]
  givenBy        ExchangeParticipant[] @relation("GivesListing")
  receivedBy     ExchangeParticipant[] @relation("ReceivesListing")

  @@index([ownerId, createdAt])
  @@index([status, type, createdAt])
  @@index([status, category])
  @@index([status, estimatedValue])
}

model Want {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String?    @db.Uuid
  listing     Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title       String
  description String     @default("")
  category    String     @default("")
  targetType  TargetType @default(ANY)
  minValue    Decimal    @db.Decimal(12, 2)
  maxValue    Decimal    @db.Decimal(12, 2)
  currency    String     @db.Char(3)
  keywords    String[]
  status      WantStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  matches Match[]

  @@index([userId, status])
  @@index([listingId])
}

/// One vector per listing or want. Carries the model name and version, so a model
/// change makes old rows stale and re-embedding replaces them. The dimension is
/// checked per row. An HNSW cosine index exists per (model, version, dim) and is
/// created in SQL (see migration 0002).
model Embedding {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectKind String                @map("subject_kind")
  subjectId   String                @map("subject_id")
  ownerId     String                @map("owner_id")
  provider    String
  model       String
  version     String
  dim         Int
  sourceHash  String                @map("source_hash")
  vector      Unsupported("vector")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at")

  @@unique([subjectKind, subjectId])
  @@index([subjectKind, model, version])
  @@index([ownerId])
  @@map("embeddings")
}

model Match {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wantId             String   @db.Uuid
  want               Want     @relation(fields: [wantId], references: [id], onDelete: Cascade)
  candidateListingId String   @db.Uuid
  candidateListing   Listing  @relation(fields: [candidateListingId], references: [id], onDelete: Cascade)
  score              Float
  semanticScore      Float
  valueScore         Float
  reasons            String[]
  explanation        String?
  explanationModel   String?
  dismissed          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([wantId, candidateListingId])
  @@index([userId, score(sort: Desc)])
}

model Exchange {
  id          String         @id @default(uuid()) @db.Uuid
  cycleKey    String
  cycleType   Int
  status      ExchangeStatus @default(PROPOSED)
  revision    Int            @default(1)
  currency    String         @db.Char(3)
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  participants ExchangeParticipant[]
  approvals    ExchangeApproval[]
  offers       Offer[]
  payments     Payment[]
  payouts      Payout[]
  reviews      Review[]

  @@index([status, createdAt])
  @@index([cycleKey])
}

model ExchangeParticipant {
  id                String           @id @default(uuid()) @db.Uuid
  exchangeId        String           @db.Uuid
  exchange          Exchange         @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id])
  givesListingId    String           @db.Uuid
  givesListing      Listing          @relation("GivesListing", fields: [givesListingId], references: [id])
  receivesListingId String           @db.Uuid
  receivesListing   Listing          @relation("ReceivesListing", fields: [receivesListingId], references: [id])
  valueGiven        Decimal          @db.Decimal(12, 2)
  valueReceived     Decimal          @db.Decimal(12, 2)
  balanceAmount     Decimal          @db.Decimal(12, 2)
  currency          String           @db.Char(3)
  approvalStatus    ApprovalStatus   @default(PENDING)
  approvedRevision  Int?
  fulfilmentStatus  FulfilmentStatus @default(PENDING)
  fulfilledAt       DateTime?
  /// True while the exchange is non-terminal. It backs the partial unique index
  /// that stops one listing being reserved by two active exchanges (migration 0002).
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  approvals ExchangeApproval[]
  payments  Payment[]
  payouts   Payout[]

  @@unique([exchangeId, userId])
  @@index([givesListingId])
  @@index([userId, createdAt])
}

model ExchangeApproval {
  id            String              @id @default(uuid()) @db.Uuid
  exchangeId    String              @db.Uuid
  exchange      Exchange            @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  participantId String              @db.Uuid
  participant   ExchangeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  revision      Int
  decision      ApprovalDecision
  note          String              @default("")
  createdAt     DateTime            @default(now())

  @@index([exchangeId, revision])
}

model Offer {
  id              String      @id @default(uuid()) @db.Uuid
  exchangeId      String      @db.Uuid
  exchange        Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  revision        Int
  fromUserId      String      @db.Uuid
  fromUser        User        @relation("OfferFrom", fields: [fromUserId], references: [id])
  toUserId        String      @db.Uuid
  toUser          User        @relation("OfferTo", fields: [toUserId], references: [id])
  message         String
  proposedChanges Json        @default("{}")
  status          OfferStatus @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([exchangeId, createdAt])
}

model Payment {
  id                 String              @id @default(uuid()) @db.Uuid
  exchangeId         String              @db.Uuid
  exchange           Exchange            @relation(fields: [exchangeId], references: [id])
  participantId      String              @db.Uuid
  participant        ExchangeParticipant @relation(fields: [participantId], references: [id])
  userId             String              @db.Uuid
  user               User                @relation(fields: [userId], references: [id])
  amount             Decimal             @db.Decimal(12, 2)
  currency           String              @db.Char(3)
  provider           String              @default("paypal")
  environment        String              @default("sandbox")
  paypalOrderId      String?             @unique
  paypalCaptureId    String?             @unique
  status             PaymentStatus       @default(CREATED)
  verified           Boolean             @default(false)
  verificationSource String?
  lastError          String?
  authorizedAt       DateTime?
  capturedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([exchangeId, participantId])
  @@index([exchangeId, status])
  @@index([userId, createdAt])
}

/// Platform-to-trader balancing payout (PayPal Payouts) for a participant who is owed money.
model Payout {
  id            String              @id @default(uuid()) @db.Uuid
  exchangeId    String              @db.Uuid
  exchange      Exchange            @relation(fields: [exchangeId], references: [id])
  participantId String              @db.Uuid
  participant   ExchangeParticipant @relation(fields: [participantId], references: [id])
  userId        String              @db.Uuid
  user          User                @relation(fields: [userId], references: [id])
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @db.Char(3)
  receiverEmail String
  senderBatchId String              @unique
  paypalBatchId String?             @unique
  paypalItemId  String?             @unique
  status        PayoutStatus        @default(PENDING)
  trigger       String              @default("automatic")
  verified      Boolean             @default(false)
  lastError     String?
  attempts      Int                 @default(0)
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([exchangeId, participantId])
  @@index([userId, createdAt])
  @@index([status])
}

model Review {
  id         String    @id @default(uuid()) @db.Uuid
  authorId   String    @db.Uuid
  author     User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId  String    @db.Uuid
  subject    User      @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  exchangeId String?   @db.Uuid
  exchange   Exchange? @relation(fields: [exchangeId], references: [id])
  rating     Int
  comment    String    @default("")
  /// True only when author and subject were both participants in this completed exchange.
  verified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // One verified review per partner per exchange. A partial index in migration 0002
  // limits each author to one unverified review per subject.
  @@unique([authorId, subjectId, exchangeId])
  @@index([subjectId, verified, createdAt])
}

/// Remembers which discovered cycles have already triggered an alert, so each cycle is announced once.
model CycleAlert {
  id             String   @id @default(uuid()) @db.Uuid
  cycleKey       String   @unique
  participantIds String[] @db.Uuid
  notifiedAt     DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  link      String           @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}
